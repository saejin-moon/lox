  "strategy_plan": [
    {
      "goal": "explore_floor",
      "when": "(true)",
      "until": "(or (xl_ge 4) (depth_ge 4))"
    },
    {
      "goal": "early_survival_stack",
      "when": "(true)",
      "until": "(or (ac_le 4) (depth_ge 7) (steps_in_goal_ge 1500))",
      "max_steps": 1500
    },
    {
      "goal": "forge_excalibur",
      "when": "(and (lawful) (xl_ge 5) (not has_excalibur))",
      "until": "(has_excalibur)",
      "max_steps": 2000
    },
    {
      "goal": "hunt_poison_res",
      "when": "(true)",
      "until": "(or (has_poison_res) (depth_ge 6))"
    },
    {
      "goal": "enter_sokoban",
      "when": "(true)",
      "until": "(or (has_reflection) (depth_ge 9) (sokoban_completed))",
      "directive": "ENTER_SOKOBAN"
    },
    {
      "goal": "equip_upgrade",
      "when": "(or (has_reflection) (depth_ge 6))",
      "until": "(or (ac_le -10) (depth_ge 8) (steps_in_goal_ge 2500))",
      "max_steps": 2500
    },
    {
      "goal": "goto_minetown",
      "when": "(true)",
      "until": "(or (ac_le 0) (steps_in_goal_ge 3000) (depth_ge 10))",
      "directive": "GOTO_MINETOWN"
    },
    {
      "goal": "survival_intrinsics",
      "when": "(depth_ge 8)",
      "until": "(or (has_mr) (depth_ge 13) (steps_in_goal_ge 3000))",
      "max_steps": 3000
    },
    {
      "goal": "descend",
      "when": "(true)",
      "until": "(depth_ge 14)",
      "directive": "DESCEND"
    },
    {
      "goal": "enter_gehennom",
      "when": "(and (in_dungeons) (depth_ge 14))",
      "until": "(or (depth_ge 22) (steps_in_goal_ge 5000))",
      "directive": "DESCEND",
      "max_steps": 5000
    },
    {
      "goal": "castle_wishing",
      "when": "(depth_ge 22)",
      "until": "(or (castle_done) (depth_ge 30) (steps_in_goal_ge 6000))",
      "max_steps": 6000
    },
    {
      "goal": "vlad_invocation",
      "when": "(depth_ge 30)",
      "until": "(or (has_candelabrum) (depth_ge 38) (steps_in_goal_ge 6000))",
      "max_steps": 6000
    },
    {
      "goal": "ascension_run",
      "when": "(has_amulet)",
      "until": "(false)"
    }
  ],
  "provenance": {
    "author": "LOX-\u03c8",
    "note": "REVERT of 3 llm-authored combat rules: A/B on v5 (100 eps each, parallel runner) showed mean score 217.0 WITH rules vs 396.4 WITHOUT (median depth 2 vs 3). Rules engraved Elbereth while adjacent at <=40% HP and forced ranged_then_kill against everything \u2014 wrong response tier for DL1-3 melee deaths. Superseded by interlock-only rule set.",
    "parent_version": 7,
    "reason": "High rate of starvation deaths at depth 1, often occurring after very long episodes (thousands of turns) where the agent fails to find food despite high turn counts. Increasing food_radius_hungry and decreasing prayer intervals to trigger emergency food recovery earlier.",
    "parent_author": "gemma-4-26b@ablation"
  }
}