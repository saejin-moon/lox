      "note": "mines attrition fix"
    },
    {
      "when": "(and (in_dungeons) (and (adjacent_hostiles) (hp_frac <= 0.4) (not has_healing)))",
      "do": "retreat",
      "unless": null,
      "note": null
    }
  ],
  "nogoods": [],
