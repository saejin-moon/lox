{
  "version": 3,
  "domain": "nethack",
  "params": {},
  "macros": [],
  "tactic_rules": [
    {
      "when": "(and (adjacent_hostiles) (hp_frac <= 0.4))",
      "do": "elbereth_first",
      "unless": null,
      "note": "emergency elbereth"
    },
    {
      "when": "(and (adjacent_hostiles) (hp_frac <= 0.7))",
      "do": "retreat_when_wounded",
      "unless": null,
      "note": "retreat when low hp"
    },
    {
      "when": "(adjacent_hostiles)",
      "do": "ranged_then_kill",
      "unless": null,
      "note": null
    }
  ],
  "nogoods": [],
  "strategy_plan": [
    {
      "goal": "explore_floor",
      "when": "(true)",
      "until": "(or (xl_ge 4) (depth_ge 4))"
    },
    {
      "goal": "forge_excalibur",
      "when": "(and (lawful) (xl_ge 5) (not has_excalibur))",
      "until": "(has_excalibur)",
      "max_steps": 2000
    },
    {
      "goal": "hunt_poison_res",
      "when": "(true)",
      "until": "(or (has_poison_res) (depth_ge 6))"
    },
    {
      "goal": "enter_sokoban",
      "when": "(true)",
      "until": "(or (has_reflection) (depth_ge 9) (sokoban_completed))",
      "directive": "ENTER_SOKOBAN"
    },
    {
      "goal": "goto_minetown",
      "when": "(true)",
      "until": "(or (ac_le 0) (steps_in_goal_ge 3000) (depth_ge 10))",
      "directive": "GOTO_MINETOWN"
    },
    {
      "goal": "descend",
      "when": "(true)",
      "until": "(false)",
      "directive": "DESCEND"
    }
  ],
  "provenance": {
    "author": "strategy-tuning author",
    "note": "equivalent to pre-R2 MacroAscensionDirector phase machine",
    "parent_version": 2,
    "reason": "Agent dying to melee damage from small monsters at low depth; increasing retreat threshold and adding elbereth-first as an emergency defensive tactic."
  }
}