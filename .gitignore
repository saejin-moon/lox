# Virtual environment & uv
.venv/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Secrets & Environment variables
.env
.env.*
!.env.example

# Large database & telemetry data
data/raw/
data/*.db
data/*.db-journal
data/*.duckdb
data/*.duckdb.wal
data/*.parquet
logs/

# Ephemeral experiment & evaluation JSON/log dumps
data/*.log
data/ablation_*.json
data/*_100ep.json
data/postR4_*.json
data/arm*.json
data/ab_*.json
data/batch_*.json
data/benchmark_results.json
data/domain_eval.json
data/r4_smoke_*.json
data/prompt_ab_live_partial.json
data/trajectory.png
data/ablation_work/

# Preserve first-class policy artifacts and program trees
!data/.gitkeep
!data/policy_program.json
!data/policy_program/
!data/revision_ledger.jsonl
!data/nogoods.json
!data/trajectory.csv
!data/compiled/
!data/compiled/**
!data/program/
!data/program/**
!data/programs/
!data/programs/**
!data/prompts/
!data/prompts/**
!data/corpus/
!data/corpus/**
